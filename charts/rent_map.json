{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": "container",
  "height": 320,
  "projection": { "type": "mercator", "center": [134, -28], "scale": 460 },
  "params": [
    { "name": "selectedState", "value": "New South Wales" },
    {
      "name": "stateClick",
      "select": { "type": "point", "on": "click", "fields": ["properties.STE_NAME16"] }
    }
  ],
  "datasets": {
    "rentByState": [
      { "state": "New South Wales", "rent": 100 },
      { "state": "Victoria", "rent": 100 },
      { "state": "Queensland", "rent": 100 },
      { "state": "South Australia", "rent": 100 },
      { "state": "Western Australia", "rent": 100 },
      { "state": "Tasmania", "rent": 100 },
      { "state": "Northern Territory", "rent": 100 },
      { "state": "Australian Capital Territory", "rent": 100 }
    ]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dtjo/FIT2179/main/data/australia_states.json",
        "format": { "type": "topojson", "feature": "STE_2016_AUST" }
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME16",
          "from": { "data": { "name": "rentByState" }, "key": "state", "fields": ["rent"] }
        }
      ],
      "mark": { "type": "geoshape", "stroke": "#0d0d0d", "strokeWidth": 1 },
      "encoding": {
        "color": {
          "field": "rent",
          "type": "quantitative",
          "scale": { "scheme": "greens", "domain": [95, 140] },
          "legend": null
        },
        "opacity": {
          "condition": { "test": "datum.properties.STE_NAME16 === selectedState", "value": 1 },
          "value": 0.28
        },
        "stroke": {
          "condition": { "test": "datum.properties.STE_NAME16 === selectedState", "value": "#e8c547" },
          "value": "#0d0d0d"
        },
        "strokeWidth": {
          "condition": { "test": "datum.properties.STE_NAME16 === selectedState", "value": 2.8 },
          "value": 1
        },
        "tooltip": [
          { "field": "properties.STE_NAME16", "title": "State" },
          { "field": "rent", "title": "Rent index", "format": ".0f" }
        ]
      }
    }
  ]
}