{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "axis": {
      "gridColor": "#242424",
      "domainColor": "#393939",
      "tickColor": "#393939",
      "labelColor": "#b9b3a5",
      "titleColor": "#d6cfbf",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#d6cfbf",
      "titleColor": "#d6cfbf",
      "orient": "top"
    },
    "view": {
      "stroke": "transparent"
    }
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/gold.csv"
  },
  "transform": [
    {
      "fold": [
        "Gold Price",
        "Cash "
      ],
      "as": [
        "Asset",
        "Value"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "axis": {
            "format": "d",
            "tickCount": 11
          }
        },
        "y": {
          "field": "Value",
          "type": "quantitative",
          "scale": {
            "zero": false
          },
          "axis": {
            "title": "Indexed to 2015 = 100"
          }
        },
        "color": {
          "field": "Asset",
          "scale": {
            "domain": [
              "Gold Price",
              "Cash "
            ],
            "range": [
              "#e8c547",
              "#888888"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Year",
            "format": "d"
          },
          {
            "field": "Asset"
          },
          {
            "field": "Value",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 28
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "axis": {
            "format": "d",
            "tickCount": 11
          }
        },
        "y": {
          "field": "Value",
          "type": "quantitative",
          "scale": {
            "zero": false
          },
          "axis": {
            "title": "Indexed to 2015 = 100"
          }
        },
        "color": {
          "field": "Asset",
          "scale": {
            "domain": [
              "Gold Price",
              "Cash "
            ],
            "range": [
              "#e8c547",
              "#888888"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Year",
            "format": "d"
          },
          {
            "field": "Asset"
          },
          {
            "field": "Value",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "axis": {
            "format": "d",
            "tickCount": 11
          }
        },
        "y": {
          "field": "Value",
          "type": "quantitative",
          "scale": {
            "zero": false
          },
          "axis": {
            "title": "Indexed to 2015 = 100"
          }
        },
        "color": {
          "field": "Asset",
          "scale": {
            "domain": [
              "Gold Price",
              "Cash "
            ],
            "range": [
              "#e8c547",
              "#888888"
            ]
          }
        },
        "text": {
          "field": "Value",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "padding": {
    "left": 4,
    "right": 40,
    "top": 6,
    "bottom": 4
  }
}